###############################################################################
# TARA — environment variables
#
# Copy this file to `.env.local` and fill in the real values. `.env.local` is
# git-ignored and must never be committed.
#
# NEXT_PUBLIC_* variables are inlined into the browser bundle at build time.
# Anything that is not safe for a customer to read must NOT carry that prefix.
#
# Every variable below is actually read by the application. Nothing here is
# aspirational — if a name is not in this file, setting it does nothing.
#
#   REQUIRED   the site will not work correctly without it
#   OPTIONAL   a feature stays switched off cleanly when it is absent
###############################################################################


# =============================================================================
# REQUIRED
# =============================================================================

# --- Supabase ----------------------------------------------------------------
# REQUIRED · public · read in the browser and on the server
#
# Project URL. The bare project origin only — no /rest/v1 or other API path.
#   e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# REQUIRED · public · read in the browser and on the server
#
# The publishable ("anon") key. Safe to expose: it grants nothing on its own,
# because every table is protected by row level security and every sensitive
# mutation runs through a SECURITY DEFINER function that checks a permission.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# NEVER add the service role key here or anywhere else in this repository.
# It bypasses row level security completely. This application does not use it,
# does not need it, and its tests deliberately prove the policies hold without
# it. If one was ever committed, rotate it in the Supabase dashboard at once.
# SUPABASE_SERVICE_ROLE_KEY=  <-- intentionally absent


# --- Site --------------------------------------------------------------------
# REQUIRED · public · inlined at build time
#
# The public origin, with no trailing slash. Used for canonical URLs, the
# sitemap, Open Graph tags, and the redirect targets sent to Supabase Auth for
# email confirmation and password reset — so it must exactly match the domain
# registered under Authentication → URL Configuration in Supabase.
#
#   Local development:  http://localhost:3000
#   PRODUCTION:         https://www.tarabd.co
#
# Never ship a build with localhost here: the confirmation and password-reset
# links emailed by Supabase would point customers at their own machine.
NEXT_PUBLIC_SITE_URL=


# =============================================================================
# OPTIONAL
# =============================================================================

# --- Google sign-in ----------------------------------------------------------
# OPTIONAL · public · default false
#
# Set to "true" only after the Google provider is enabled in Supabase Auth and
# its redirect URL is registered. Leaving it "false" hides the button entirely.
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false


# --- Transactional email -----------------------------------------------------
# OPTIONAL · server only
#
# With these unset, TARA sends no email. Every order and every status change is
# still recorded in `notification_outbox` as it happens and is visible under
# /admin/settings → "Order events" — the rows simply stay queued. Nothing
# pretends to have been delivered.
#
# Set both to turn sending on. The provider is Resend, called over its REST API
# (no SDK, no build step). Swapping providers means one file: lib/email/provider.ts.
#
#   RESEND_API_KEY   from https://resend.com → API Keys. Sending permission is
#                    enough; it does not need full access.
#   EMAIL_FROM       a verified sender on a domain you control, in the form
#                    "TARA <orders@tarabd.co>". An unverified sender is rejected.
#
# The address the store's own new-order copy goes to is NOT here: it is the
# `order_notification_email` setting in /admin/settings, so it can be changed
# without a deploy.
RESEND_API_KEY=
EMAIL_FROM=


# --- Error monitoring --------------------------------------------------------
# OPTIONAL · public by design · server and browser
#
# A Sentry-compatible DSN. With it set, uncaught server errors (via
# instrumentation.ts), server action failures, checkout failures and client
# exceptions are reported. With it unset, every reporting call is a no-op.
#
# The DSN is public on purpose: it is a write-only ingestion key that cannot
# read anything back, and the browser needs it to report client-side errors.
#
# Passwords, tokens, cookies, addresses, phone numbers and email addresses are
# scrubbed before anything leaves the process — see lib/observability.ts.
NEXT_PUBLIC_SENTRY_DSN=

# OPTIONAL · server only · defaults to NODE_ENV
# Labels reports so staging noise does not page anyone about production.
SENTRY_ENVIRONMENT=

# OPTIONAL · public · defaults to unset
# Tags reports with a release, so a regression can be tied to a deploy.
NEXT_PUBLIC_APP_VERSION=


# --- Logging -----------------------------------------------------------------
# OPTIONAL · server only · debug | info | warn | error
#
# Defaults to "info" in production and "debug" everywhere else.
LOG_LEVEL=


# =============================================================================
# TESTING — never set these in a production environment
# =============================================================================
#
# The database integration suite (`npm run test:integration`) and the browser
# suite (`npm run test:e2e`) write real rows: they place orders, deduct stock
# and edit the catalogue. Point them at a dedicated testing Supabase project,
# never at production. Both skip cleanly with a stated reason when unset.
#
# See docs/TESTING.md for how to provision the accounts.

# TEST_SUPABASE_URL=
# TEST_SUPABASE_PUBLISHABLE_KEY=
# TEST_CUSTOMER_EMAIL=
# TEST_CUSTOMER_PASSWORD=
# TEST_CUSTOMER_B_EMAIL=
# TEST_CUSTOMER_B_PASSWORD=
# TEST_SUPPORT_EMAIL=
# TEST_SUPPORT_PASSWORD=
# TEST_FULFILMENT_EMAIL=
# TEST_FULFILMENT_PASSWORD=
# TEST_ADMIN_EMAIL=
# TEST_ADMIN_PASSWORD=

# E2E_BASE_URL=http://localhost:3000
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=
# E2E_CUSTOMER_EMAIL=
# E2E_CUSTOMER_PASSWORD=


# =============================================================================
# PAYMENT — nothing to configure
# =============================================================================
#
# TARA takes cash on delivery only, and that is enforced in the database:
# place_order() writes 'cash_on_delivery' on every order and ignores any other
# value a client sends. No payment gateway is integrated and no gateway
# credentials belong in this file.
#
# If online payment is ever added, verify each payment server-side against the
# provider's own API before setting an order's payment status — never from a
# client-side redirect.
