{
  "name": "tara",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./tests/resolve-hooks.mjs --test \"tests/*.test.ts\"",
    "test:watch": "node --import ./tests/resolve-hooks.mjs --test --watch \"tests/*.test.ts\"",
    "test:integration": "node --import ./tests/resolve-hooks.mjs --test \"tests/integration/*.test.ts\"",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.111.0",
    "lucide-react": "^0.469.0",
    "next": "16.2.12",
    "pdf-lib": "^1.17.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "16.2.12",
    "postcss": "^8.5.24",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "postcss": "^8.5.24",
    "sharp": "^0.35.3"
  }
}
